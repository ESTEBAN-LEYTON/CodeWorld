# Copiar a .env y completar. Nunca subir .env al repositorio.
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://codeworld:codeworld@localhost:5432/codeworld?schema=public"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Base de datos SOLO para las pruebas de integración (se vacía en cada ejecución).
# Sin esta variable, las pruebas que necesitan PostgreSQL se omiten.
TEST_DATABASE_URL="postgresql://codeworld:codeworld@localhost:5432/codeworld_test?schema=public"

# Correo real para el código 2FA (Brevo). Sin estas dos variables, el código sale en la consola.
# BREVO_API_KEY=
# CORREO_REMITENTE=

# Producción detrás de un proxy (Render y similares): 1. En local: 0.
# SALTOS_PROXY=1

# Peticiones por minuto e IP. Se definen juntas; por defecto 300 y 20.
# LIMITE_API=300
# LIMITE_LOGIN=20
