// Modelo relacional de CodeWorld (Figura 8 del informe).
// Principio Zero-Data (Ley N.° 19.628): ALUMNO no guarda nombre real, correo ni biometría.
// Progreso y XP se registran por DESAFIO; un nivel completo se calcula, no se almacena.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tutor {
  id                 String           @id @default(uuid()) @db.Uuid
  username           String           @unique
  passwordHash       String           @map("password_hash")
  twoFactorEnabled   Boolean          @default(true) @map("two_factor_enabled")
  /// Teléfono o correo verificado del adulto, usado para enviar el segundo factor.
  contactoVerificado String           @map("contacto_verificado")
  createdAt          DateTime         @default(now()) @map("created_at")
  alumnos            Alumno[]
  consentimientos    Consentimiento[]

  @@map("tutor")
}

model Alumno {
  id              String           @id @default(uuid()) @db.Uuid
  tutorId         String           @map("tutor_id") @db.Uuid
  username        String           @unique
  /// Clave definida por el tutor; solo se guarda su hash.
  passwordHash    String           @map("password_hash")
  /// Identificador anónimo autogenerado; nunca se deriva de datos personales.
  anonId          String           @unique @default(uuid()) @map("anon_id")
  edad            Int
  createdAt       DateTime         @default(now()) @map("created_at")
  tutor           Tutor            @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  progresos       Progreso[]
  consentimientos Consentimiento[]

  @@map("alumno")
}

/// Registro inmutable del consentimiento, disociado de la actividad del alumno.
model Consentimiento {
  id                 String   @id @default(uuid()) @db.Uuid
  tutorId            String   @map("tutor_id") @db.Uuid
  alumnoId           String   @map("alumno_id") @db.Uuid
  otorgadoEn         DateTime @default(now()) @map("otorgado_en")
  metodoVerificacion String   @map("metodo_verificacion")
  tutor              Tutor    @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  alumno             Alumno   @relation(fields: [alumnoId], references: [id], onDelete: Restrict)

  @@map("consentimiento")
}

model Nivel {
  id          String    @id
  orden       Int       @unique
  titulo      String
  descripcion String
  desafios    Desafio[]

  @@map("nivel")
}

model Desafio {
  /// Identificador estable (p. ej. "inicial-1"), compartido con el progreso guardado sin conexión.
  id                String           @id
  nivelId           String           @map("nivel_id")
  orden             Int
  titulo            String
  enunciado         String
  /// Celdas del laberinto y dirección inicial del personaje: { celdas: string[], dirInicial }.
  laberinto         Json
  /// Tipos de bloque Blockly permitidos en la caja de herramientas.
  bloquesPermitidos String[]         @map("bloques_permitidos")
  /// Máximo de bloques sugerido; superarlo no es error, solo una pista.
  bloquesOptimos    Int?             @map("bloques_optimos")
  xpRecompensa      Int              @map("xp_recompensa")
  nivel             Nivel            @relation(fields: [nivelId], references: [id], onDelete: Cascade)
  guias             GuiaCorrectiva[]
  progresos         Progreso[]

  @@unique([nivelId, orden])
  @@map("desafio")
}

model GuiaCorrectiva {
  id          String  @id @default(uuid()) @db.Uuid
  desafioId   String  @map("desafio_id")
  /// Patrón de error del Interpretador: choque, incompleto, limite_pasos, vacio.
  patronError String  @map("patron_error")
  mensaje     String
  orden       Int
  desafio     Desafio @relation(fields: [desafioId], references: [id], onDelete: Cascade)

  @@map("guia_correctiva")
}

model Progreso {
  id           String   @id @default(uuid()) @db.Uuid
  alumnoId     String   @map("alumno_id") @db.Uuid
  desafioId    String   @map("desafio_id")
  completadoEn DateTime @map("completado_en")
  /// Toma el valor de DESAFIO.xp_recompensa.
  xpObtenido   Int      @map("xp_obtenido")
  intentos     Int      @default(1)
  alumno       Alumno   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  desafio      Desafio  @relation(fields: [desafioId], references: [id], onDelete: Cascade)

  @@unique([alumnoId, desafioId])
  @@map("progreso")
}
